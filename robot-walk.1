<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 360" role="img" aria-labelledby="title desc">
  <title id="title">Junizar Maulana animated walking robot</title>
  <desc id="desc">A friendly orange robot walks through a futuristic dark landscape.</desc>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#050505"/>
      <stop offset="1" stop-color="#17100b"/>
    </linearGradient>
    <linearGradient id="orange" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff9a3d"/>
      <stop offset="0.55" stop-color="#ff6b00"/>
      <stop offset="1" stop-color="#ff3b00"/>
    </linearGradient>
    <radialGradient id="horizon">
      <stop offset="0" stop-color="#ff6b00" stop-opacity=".28"/>
      <stop offset="1" stop-color="#ff6b00" stop-opacity="0"/>
    </radialGradient>
    <filter id="glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="soft" x="-50%" y="-100%" width="200%" height="300%">
      <feGaussianBlur stdDeviation="8"/>
    </filter>
    <pattern id="grid" width="42" height="22" patternUnits="userSpaceOnUse" patternTransform="skewX(-22)">
      <path d="M42 0H0V22" fill="none" stroke="#ff6b00" stroke-opacity=".13" stroke-width="1"/>
    </pattern>
    <clipPath id="screenClip"><rect x="-52" y="-38" width="104" height="67" rx="18"/></clipPath>
    <style>
      .bot { animation: hover 1.45s ease-in-out infinite; transform-origin: 400px 190px; }
      .head { animation: look 4.8s ease-in-out infinite; transform-origin: 400px 130px; }
      .antenna-tip { animation: pulse .9s ease-in-out infinite alternate; }
      .eye { animation: blink 4.2s infinite; transform-origin: center; }
      .arm-left { animation: arm-left .9s ease-in-out infinite alternate; transform-origin: 350px 188px; }
      .arm-right { animation: arm-right .9s ease-in-out infinite alternate; transform-origin: 450px 188px; }
      .leg-left { animation: leg-left .9s ease-in-out infinite alternate; transform-origin: 378px 242px; }
      .leg-right { animation: leg-right .9s ease-in-out infinite alternate; transform-origin: 422px 242px; }
      .ground { animation: ground 2.6s linear infinite; }
      .scan { animation: scan 2.4s ease-in-out infinite; }
      .star-a { animation: twinkle 1.8s ease-in-out infinite alternate; }
      .star-b { animation: twinkle 2.6s .5s ease-in-out infinite alternate; }
      .dash { animation: dash 1.8s linear infinite; }
      @keyframes hover { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
      @keyframes look { 0%,35%,100%{transform:rotate(0)} 48%,66%{transform:rotate(-4deg)} }
      @keyframes pulse { to{opacity:.35;transform:scale(.7)} }
      @keyframes blink { 0%,44%,48%,100%{transform:scaleY(1)} 46%{transform:scaleY(.08)} }
      @keyframes arm-left { from{transform:rotate(18deg)} to{transform:rotate(-22deg)} }
      @keyframes arm-right { from{transform:rotate(-18deg)} to{transform:rotate(22deg)} }
      @keyframes leg-left { from{transform:rotate(-12deg)} to{transform:rotate(14deg)} }
      @keyframes leg-right { from{transform:rotate(12deg)} to{transform:rotate(-14deg)} }
      @keyframes ground { to{transform:translateX(-42px)} }
      @keyframes scan { 0%,100%{transform:translateY(-22px);opacity:.15} 50%{transform:translateY(38px);opacity:.8} }
      @keyframes twinkle { to{opacity:.18;transform:scale(.55)} }
      @keyframes dash { to{stroke-dashoffset:-38} }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
    </style>
  </defs>

  <rect width="800" height="360" rx="28" fill="url(#bg)"/>
  <ellipse cx="400" cy="282" rx="285" ry="105" fill="url(#horizon)"/>
  <g fill="#ff8a2b" filter="url(#glow)">
    <circle class="star-a" cx="105" cy="74" r="2"/><circle class="star-b" cx="164" cy="135" r="1.5"/>
    <circle class="star-b" cx="650" cy="91" r="2"/><circle class="star-a" cx="708" cy="151" r="1.5"/>
    <circle class="star-a" cx="580" cy="55" r="1.3"/><circle class="star-b" cx="249" cy="61" r="1.2"/>
  </g>
  <path class="dash" d="M88 185C168 109 238 110 294 151M706 192C654 132 599 124 538 153" fill="none" stroke="#ff6b00" stroke-opacity=".23" stroke-width="2" stroke-dasharray="3 16"/>
  <ellipse cx="400" cy="308" rx="82" ry="12" fill="#ff6b00" opacity=".2" filter="url(#soft)"/>

  <g class="bot">
    <g class="arm-left">
      <rect x="327" y="180" width="24" height="77" rx="12" fill="#292929" stroke="#ff6b00" stroke-width="4"/>
      <circle cx="339" cy="259" r="13" fill="url(#orange)"/>
    </g>
    <g class="arm-right">
      <rect x="449" y="180" width="24" height="77" rx="12" fill="#292929" stroke="#ff6b00" stroke-width="4"/>
      <circle cx="461" cy="259" r="13" fill="url(#orange)"/>
    </g>

    <g class="leg-left">
      <rect x="365" y="235" width="27" height="64" rx="13" fill="#242424" stroke="#ff6b00" stroke-width="4"/>
      <rect x="350" y="286" width="49" height="20" rx="10" fill="url(#orange)"/>
    </g>
    <g class="leg-right">
      <rect x="408" y="235" width="27" height="64" rx="13" fill="#242424" stroke="#ff6b00" stroke-width="4"/>
      <rect x="401" y="286" width="49" height="20" rx="10" fill="url(#orange)"/>
    </g>

    <rect x="345" y="171" width="110" height="89" rx="34" fill="#161616" stroke="url(#orange)" stroke-width="5"/>
    <path d="M375 207h50" stroke="#ff6b00" stroke-width="5" stroke-linecap="round" opacity=".85"/>
    <circle cx="400" cy="231" r="12" fill="#ff6b00" opacity=".18"/>
    <circle cx="400" cy="231" r="5" fill="#ff8a2b" filter="url(#glow)"/>

    <g class="head">
      <path d="M400 90V72" stroke="#ff6b00" stroke-width="5" stroke-linecap="round"/>
      <circle class="antenna-tip" cx="400" cy="65" r="8" fill="#ff6b00" filter="url(#glow)"/>
      <rect x="338" y="92" width="124" height="86" rx="30" fill="#202020" stroke="url(#orange)" stroke-width="5"/>
      <rect x="348" y="102" width="104" height="67" rx="18" fill="#090909"/>
      <g clip-path="url(#screenClip)" transform="translate(400 140)">
        <rect class="scan" x="-52" y="-4" width="104" height="3" fill="#ff6b00" filter="url(#glow)"/>
      </g>
      <g class="eye" fill="#ff7a16" filter="url(#glow)">
        <rect x="365" y="126" width="18" height="20" rx="7"/>
        <rect x="417" y="126" width="18" height="20" rx="7"/>
      </g>
      <path d="M383 157q17 12 34 0" fill="none" stroke="#ff6b00" stroke-width="4" stroke-linecap="round"/>
    </g>
  </g>

  <g class="ground">
    <rect x="-42" y="315" width="884" height="45" fill="url(#grid)"/>
  </g>
  <path d="M54 315H746" stroke="#ff6b00" stroke-opacity=".55" stroke-width="2"/>
</svg>
